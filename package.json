{
  "name": "mcbot",
  "version": "1.1.0",
  "description": "Minecraft 假人：狩猎 mooshroom/cow、自动进食、自动存仓、网页监控",
  "main": "bot.js",
  "scripts": {
    "start": "node --max-old-space-size=1024 bot.js",
    "start:auto": "node --max-old-space-size=1024 bot.js --auto-start",
    "build:viewer": "cd web/viewer-src && webpack",
    "gen:assets": "node tools/gen-viewer-assets.js",
    "test": "node test/smoke.js"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-viewer": "^1.33.0",
    "socket.io": "^4.8.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "process": "^0.11.10",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "license": "MIT"
}
